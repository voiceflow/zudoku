{
  "compilerOptions": {
    "composite": false,
    "rootDir": "src",
    "outDir": "dist",
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable", "WebWorker"],
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "resolveJsonModule": true,
    "useUnknownInCatchVariables": false,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "strictNullChecks": true,
    "declaration": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "useDefineForClassFields": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@voiceflow/zudoku/components": ["./src/lib/components/index.ts"],
      "@voiceflow/zudoku/ui/*": ["./src/lib/ui/*"],
      "@voiceflow/zudoku/plugins/openapi": [
        "./src/lib/plugins/openapi/index.ts"
      ],
      "@voiceflow/zudoku/plugins/search-inkeep": [
        "./src/lib/plugins/search-inkeep/index.tsx"
      ],
      "@voiceflow/zudoku/plugins/search-pagefind": [
        "./src/lib/plugins/search-pagefind/index.tsx"
      ],
      "@voiceflow/zudoku/plugins": ["./src/lib/core/plugins.ts"],
      "@voiceflow/zudoku/plugins/api-keys": [
        "./src/lib/plugins/api-keys/index.tsx"
      ]
    }
  },
  "exclude": ["node_modules", "dist"],
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
